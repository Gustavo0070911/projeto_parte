programa {
  funcao inicio() {

                    escreva ("
Pressione ENTER para voltar ao menu...")
                    leia(tecla_pausa)
                    pare

                caso 0:
                    limpa()
                    escreva("
Encerrando seleção de itens e indo para o pagamento...
")
                    pare

                caso contrario:
                    limpa ()
                    escreva ("Opção inválida! Escolha uma das opções do menu.
")
                    escreva ("
Pressione ENTER para continuar...")
  }
}
